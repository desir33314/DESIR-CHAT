rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.id == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 32
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60;
      allow update: if isOwner(userId)
        && request.resource.data.id == existing().id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'statusMessage', 'avatarUrl', 'isOnline', 'lastSeen', 'updatedAt']);
      allow delete: if false;
    }

    // Chats Collection
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && request.auth.uid in resource.data.participantIds;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && isValidId(chatId)
        && request.resource.data.id == chatId
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() >= 2
        && request.resource.data.participantIds.size() <= 50;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageText', 'lastMessageTimestamp', 'lastMessageSenderId', 'updatedAt', 'title', 'avatarUrl', 'participantIds']);
      allow delete: if isSignedIn() && resource.data.createdById == request.auth.uid;

      // Messages Subcollection
      match /messages/{messageId} {
        allow get, list: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.chatId == chatId
          && (request.resource.data.text is string && request.resource.data.text.size() <= 4000);
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readBy']);
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // Friend Requests Collection
    match /friendRequests/{requestId} {
      allow get: if isSignedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && (resource.data.toUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
    }
  }
}
